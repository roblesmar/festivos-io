{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://festivos.io/v1/schema/escolar-ccaa.json",
  "title": "Calendario escolar de una CCAA para un curso",
  "type": "object",
  "required": ["version", "year", "course", "ccaa", "source"],
  "properties": {
    "schema": { "type": "string" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "country": { "const": "ES" },
    "calendarType": { "const": "escolar" },
    "year": { "type": "integer" },
    "course": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{4}$" },
    "ccaa": {
      "type": "object", "required": ["code", "name"],
      "properties": { "code": { "type": "string", "pattern": "^ES-[A-Z]{2}$" }, "name": { "type": "string" } }
    },
    "confidence": { "enum": ["alta", "media", "baja"] },
    "source": {
      "type": "object", "required": ["ref"],
      "properties": { "ref": { "type": "string" }, "boletin": { "type": "string" }, "fecha": { "type": "string" }, "url": { "type": "string", "format": "uri" } }
    },
    "disclaimer": { "type": "string" },
    "terms": {
      "type": "array",
      "description": "inicio y fin de clases por etapa",
      "items": { "type": "object", "properties": { "stage": { "type": "string" }, "start": { "type": "string" }, "end": { "type": "string" } } }
    },
    "breaks": {
      "type": "array",
      "description": "periodos vacacionales (Navidad, Semana Santa...)",
      "items": { "type": "object", "required": ["name"], "properties": { "name": { "type": "object", "required": ["es"], "additionalProperties": { "type": "string" } }, "from": { "type": "string" }, "to": { "type": "string" } } }
    },
    "nonSchoolDays": {
      "type": "array",
      "description": "días no lectivos (festivos escolares, libre disposición autonómica)",
      "items": { "type": "object", "required": ["date"], "properties": { "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }, "name": { "type": "object", "additionalProperties": { "type": "string" } } } }
    },
    "notes": { "type": "string" }
  }
}
